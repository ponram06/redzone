{
  "name": "contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A Foundry project for the QoreChain EVM, with a helper that opens the EVM authorisation window.",
  "scripts": {
    "forge-std": "forge install foundry-rs/forge-std --no-git && forge install OpenZeppelin/openzeppelin-contracts@v5.1.0 --no-git",
    "build": "forge build",
    "test": "forge test",
    "window": "tsx --env-file=.env scripts/window.ts",
    "referee-key": "tsx scripts/referee-key.ts",
    "attack": "tsx --env-file=.env scripts/qday-attack.ts",
    "attack:advanced": "tsx --env-file=.env scripts/qday-attack-advanced.ts",
    "deploy:vault": "forge script script/DeployVault.s.sol --rpc-url qorechain_testnet --broadcast",
    "deploy:registry": "forge script script/DeployRedZone.s.sol --rpc-url qorechain_testnet --broadcast",
    "v3-proofs": "tsx --env-file=.env scripts/v3-proofs.ts",
    "deploy:v3": "tsx --env-file=.env scripts/deploy-v3.ts",
    "typecheck": "tsc --noEmit",
    "v4-proofs": "tsx --env-file=.env scripts/v4-proofs.ts",
    "deploy:v4": "tsx --env-file=.env scripts/deploy-v4.ts"
  },
  "dependencies": {
    "@cosmjs/stargate": "^0.39.0",
    "@qorechain/evm": "^0.14.0",
    "@qorechain/sdk": "^0.14.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "create-qorechain-dapp": "^0.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "viem": "^2.0.0"
  }
}
