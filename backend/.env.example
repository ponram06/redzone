# RedZone backend. Copy to .env (git-ignored) and adjust.
PORT=8787

# Referee ML-DSA-87 key created by `npm run referee-key` in contracts/ (secret, git-ignored).
REFEREE_KEY_FILE=../contracts/.referee-key.json

# LLM brain (optional; the rule brain needs nothing). Set BRAIN_BASE_URL to turn it on. Any OpenAI-compatible API:
#   Groq:       BRAIN_BASE_URL=https://api.groq.com/openai/v1        BRAIN_MODEL=llama-3.3-70b-versatile
#   Gemini:     BRAIN_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  BRAIN_MODEL=gemini-2.0-flash
#   OpenRouter: BRAIN_BASE_URL=https://openrouter.ai/api/v1          BRAIN_MODEL=nvidia/nemotron-3.5-super-vl:free,google/gemma-4-31b-it:free
# BRAIN_MODEL may list several models, comma-separated: a busy model falls through to the next.
#   Ollama:     BRAIN_BASE_URL=http://localhost:11434/v1             BRAIN_MODEL=llama3.2   (no key)
BRAIN_BASE_URL=
BRAIN_API_KEY=
BRAIN_MODEL=

# Where replays are stored.
DATA_DIR=./data

# Server
HOST=127.0.0.1
# Allowed web origin for CORS (empty = any).
CORS_ORIGIN=
# Brain calls per minute per IP (attempt, practice, utility).
BRAIN_RATE_LIMIT=6
