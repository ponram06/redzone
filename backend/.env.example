# RedZone backend. Copy to .env (git-ignored) and adjust.
PORT=8787

# Referee ML-DSA-87 key created by `npm run referee-key` in contracts/ (secret, git-ignored).
REFEREE_KEY_FILE=../contracts/.referee-key.json

# LLM brain (optional; the rule brain needs nothing). Set BRAIN_BASE_URL to turn it on. Any OpenAI-compatible API:
#   Groq:       BRAIN_BASE_URL=https://api.groq.com/openai/v1        BRAIN_MODEL=llama-3.3-70b-versatile
#   Gemini:     BRAIN_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  BRAIN_MODEL=gemini-2.0-flash
#   OpenRouter: BRAIN_BASE_URL=https://openrouter.ai/api/v1          BRAIN_MODEL=nvidia/nemotron-3.5-super-vl:free,google/gemma-4-31b-it:free
# BRAIN_MODEL may list several models, comma-separated: a busy model falls through to the next.
#   Ollama:     BRAIN_BASE_URL=http://localhost:11434/v1             BRAIN_MODEL=llama3.2   (no key)
BRAIN_BASE_URL=
BRAIN_API_KEY=
BRAIN_MODEL=

# Where replays are stored.
DATA_DIR=./data

# Server
HOST=127.0.0.1
# Allowed web origin for CORS (empty = any).
CORS_ORIGIN=
# Brain calls per minute per IP (attempt, practice, utility).
BRAIN_RATE_LIMIT=6

# Backup models, tried in order (1..9) only when every BRAIN_MODEL fails, e.g. the free daily
# limit is used up. Use other companies, so one provider being busy or empty does not affect them.
#   Groq (free, no card):   FALLBACK_1_BASE_URL=https://api.groq.com/openai/v1  FALLBACK_1_MODEL=llama-3.1-8b-instant
#   Gemini (free, no card): FALLBACK_2_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  FALLBACK_2_MODEL=gemini-2.5-flash
#   Deploy (paid, cheap):   FALLBACK_3_BASE_URL=https://api-cdn.deploy.com/api/v1  FALLBACK_3_MODEL=zai-org/glm-5.3-flash
#   Local Ollama (last):    FALLBACK_4_BASE_URL=http://localhost:11434/v1  FALLBACK_3_MODEL=qwen3.5:4b
#                           FALLBACK_4_EXTRA_BODY={"reasoning_effort":"none"}   (turns off slow thinking)
FALLBACK_1_BASE_URL=
FALLBACK_1_MODEL=
FALLBACK_1_API_KEY=
FALLBACK_1_EXTRA_BODY=
FALLBACK_1_TIMEOUT_MS=120000

# Relayer for QoreX players (QoreX cannot send EVM transactions yet). Use a NEW account holding a
# few QOR for gas, never the Q-Day Drill account. Its EVM window is scoped to our two contracts.
RELAYER_PRIVATE_KEY=
RELAYER_PQC_RECOVERY_CODE=
# One-time sign-up fee for new players, in uqor (1 QOR = 1,000,000 uqor), paid to the relayer
# so players fund the gas. 0 turns sign-up off.
SIGNUP_FEE_UQOR=100000
