{
  "name": "redzone-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RedZone robot brain, deterministic referee and ML-DSA-87 verdict signer.",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "test": "vitest run --exclude test/live.test.ts",
    "test:live": "vitest run test/live.test.ts",
    "bench": "tsx --env-file-if-exists=.env scripts/bench.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@cosmjs/stargate": "^0.39.0",
    "@fastify/cors": "^11.4.3",
    "@fastify/static": "^8.3.0",
    "@qorechain/sdk": "^0.14.0",
    "@scure/base": "^1.2.6",
    "fastify": "^5.12.8",
    "viem": "^2.57.20"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
